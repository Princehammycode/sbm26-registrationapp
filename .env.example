# Server Configuration
PORT=3000
NODE_ENV=production

# API Configuration (Frontend)
# Set this to your deployed backend URL
# For Railway: https://your-app.up.railway.app/api
# For local: http://localhost:3000/api
API_BASE_URL=https://your-app.up.railway.app/api

# Brevo Email Configuration
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_FROM_EMAIL=your-verified-email@gmail.com


# mNotify SMS API Configuration
MNOTIFY_API_KEY=your-mnotify-api-key-here
MNOTIFY_SENDER_ID=your-sender-id-here

# Google Sheets Configuration
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
USE_GOOGLE_SHEETS=true

# PostgreSQL Database Configuration (Railway)
# Railway will auto-provide this via reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# MySQL Database Configuration (Optional - legacy)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=your-db-name-here

# Application Configuration
# For local development:
TICKET_DOWNLOAD_BASE_URL=http://localhost:3000/ticket
FRONTEND_URL=http://localhost:3000

# For production (uncomment and update when deploying):
# TICKET_DOWNLOAD_BASE_URL=https://yourdomain.com/ticket
# FRONTEND_URL=https://yourdomain.com

# Admin Authentication (CHANGE THESE!)
ADMIN_USERNAME=your-admin-username-here
ADMIN_PASSWORD=your-admin-password-here
JWT_SECRET=your-jwt-secret-here

# Security
SESSION_TIMEOUT=21600000
# 21600000 = 6 hours in milliseconds
